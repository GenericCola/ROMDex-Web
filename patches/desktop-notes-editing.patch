 export function assetPath(publicDir,url){const u=new URL(url);if(!trustedURL(url))throw Error('Untrusted Application Origin.');let rel=decodeURIComponent(u.pathname);if(rel==='/')rel='/index.html';if(rel.includes('\\')||rel.includes('\0')||rel.split('/').includes('..'))throw Error('Invalid Asset Path.');const result=path.resolve(publicDir,'.'+rel);if(!result.startsWith(path.resolve(publicDir)+path.sep))throw Error('Invalid Asset Path.');return result;}

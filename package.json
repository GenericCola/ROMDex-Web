{
  "name": "romdex-web",
  "version": "0.0.1",
  "type": "module",
  "author": {
    "name": "Gobind Singh",
    "email": "thesinghgobind@gmail.com",
    "url": "https://github.com/theGobindSingh/"
  },
  "private": true,
  "scripts": {
    "prepare": "husky && node scripts/link-agents.js",
    "prebuild": "node scripts/lint.mjs --fix",
    "dev": "node scripts/next.mjs dev --port 3001",
    "build": "node scripts/next.mjs build && node scripts/build-pwa.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "browser:install": "node scripts/playwright.mjs install chromium firefox webkit",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/unit/*.test.tsx && node --test tests/worker.test.mjs tests/build.test.mjs tests/hosting.test.mjs tests/youtrack/*.test.mjs",
    "check": "pnpm typecheck && pnpm typecheck:tests && pnpm typecheck:server && pnpm lint && pnpm test && pnpm test:server",
    "test:e2e": "node scripts/playwright.mjs test",
    "icons:build": "node scripts/build-icons.mjs",
    "package:youtrack": "node scripts/package-youtrack.mjs",
    "test:server": "node --experimental-strip-types --test server/*.test.ts",
    "typecheck:server": "tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "buffer": "6.0.3",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "jose": "6.2.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/mcp": "^0.0.83",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/next": "^2.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webadeva/eslint-config": "^0.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass": "^1.105.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0",
  "description": "ROMDex React and PWA foundation"
}
